
<div class="mb-6">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900">
    User Details
  </h1>

  <p class="mt-1 text-sm text-gray-500">
    View user information and account details.
  </p>
</div>


<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

  <div class="p-6 sm:p-8">

    <div class="flex flex-col gap-6 sm:flex-row sm:items-start">

      <% if @user.avatar.exists? %>
        <%= image_tag @user.avatar.expiring_url(3600),
            class: "h-32 w-32 rounded-full object-cover ring-4 ring-gray-100" %>
      <% end %>


      <div class="flex-1">

        <h2 class="text-2xl font-bold text-gray-900">
          <%= @user.name %>
        </h2>


        <div class="mt-6 grid gap-4 sm:grid-cols-2">

          <div class="rounded-lg bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              Email
            </p>

            <p class="mt-1 break-all text-sm font-medium text-gray-900">
              <%= @user.email %>
            </p>
          </div>


          <div class="rounded-lg bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              Age
            </p>

            <p class="mt-1 text-sm font-medium text-gray-900">
              <%= @user.age %>
            </p>
          </div>


          <div class="rounded-lg bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              Status
            </p>

            <div class="mt-2">
              <%= user_status(@user) %>
            </div>
          </div>


          <div class="rounded-lg bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              Posts
            </p>

            <p class="mt-1 text-sm font-medium text-gray-900">
              <%= @user.posts.count %>
            </p>
          </div>

        </div>

      </div>

    </div>


    <div class="mt-8 flex flex-wrap gap-3 border-t border-gray-100 pt-6">

      <%= link_to "Edit User",
          edit_user_path(@user),
          class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700" %>

      <%= button_to "Delete User",
          user_path(@user),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700" %>

      <%= link_to "Back to Users",
          users_path,
          class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50" %>

    </div>

  </div>

</div>

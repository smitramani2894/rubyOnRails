
<div class="mb-8 flex items-center justify-between rounded-xl bg-white p-5 shadow-sm">
  <div>
    <% if current_user %>
      <p class="text-sm text-gray-500">
        Logged in as:
        <strong class="font-semibold text-gray-900">
          <%= current_user.name %>
        </strong>
      </p>
    <% end %>
  </div>

  <% if current_user %>
    <%= button_to "Logout",
        logout_path,
        method: :delete,
        class: "rounded-lg bg-red-500 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-600" %>
  <% end %>
</div>


<div class="mb-6">
  <h1 class="text-4xl font-bold tracking-tight text-gray-900">
    Users
  </h1>

  <p class="mt-1 text-sm text-gray-500">
    Manage and view all registered users.
  </p>
</div>


<div class="mb-6 flex flex-wrap items-center gap-3">
  <%= link_to "All",
      users_path,
      class: "rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800" %>

  <%= link_to "Active",
      users_path(status: "active"),
      class: "rounded-lg bg-green-100 px-4 py-2 text-sm font-medium text-green-700 hover:bg-green-200" %>

  <%= link_to "Inactive",
      users_path(status: "inactive"),
      class: "rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200" %>

  <%= link_to "+ Add User",
      new_user_path,
      class: "ml-auto rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700" %>
</div>


<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

  <% @users.each do |user| %>

    <div class="flex items-center justify-between border-b border-gray-100 p-5 transition hover:bg-gray-50">

      <div>
        <h2 class="text-lg font-semibold text-gray-900">
          <%= link_to user.name,
              user_path(user),
              class: "hover:text-blue-600" %>
        </h2>

        <div class="mt-2 space-y-1 text-sm text-gray-500">
          <p>
            <span class="font-medium text-gray-700">Email:</span>
            <%= user.email %>
          </p>

          <p>
            <span class="font-medium text-gray-700">Age:</span>
            <%= user.age %>
          </p>
        </div>
      </div>

      <div>
        <% if user.is_active? %>
          <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
            Active
          </span>
        <% else %>
          <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
            Inactive
          </span>
        <% end %>
      </div>

    </div>

  <% end %>

</div>

<div class="mb-6">
  <h1 class="text-4xl font-bold tracking-tight text-gray-900">
    Create User
  </h1>

  <p class="mt-2 text-sm text-gray-600">
    Add a new user to your application.
  </p>
</div>

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
  <div class="p-6">
    <%= render "form", submit_label: "Create User" %>
  </div>
</div>

<div class="mt-6">
  <%= link_to "← Back to Users",
      users_path,
      class: "inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50" %>
</div>

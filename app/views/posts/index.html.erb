<h1>Posts</h1>

<%= link_to "New Post", new_post_path %>

<hr>

<% @posts.each do |post| %>
  <div>
    <h2><%= post.title %></h2>

    <p>
      <strong>Author:</strong>
      <%= post.user.name %>
    </p>

    <p>
      <%= post.content %>
    </p>

    <%= link_to "View Post", post_path(post) %>
  </div>

  <hr>
<% end %>